{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://ploinky.local/llm-runtime/launcher-describe.schema.json",
    "title": "Launcher describe output",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "id",
        "modelId",
        "engine",
        "modelFormat",
        "hfRepoId",
        "hfRevision",
        "modelFiles",
        "supportedAccelerators",
        "supportedPlatforms",
        "configurableParameters",
        "profiles",
        "resourceEstimates"
    ],
    "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_-]|[.](?=[a-zA-Z0-9_-])){0,127}$" },
        "modelId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "engine": { "enum": ["llamacpp", "vllm", "sglang", "trtllm", "openvino"] },
        "modelFormat": { "type": "string", "minLength": 1, "maxLength": 64 },
        "hfRepoId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "hfRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "modelFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "supportedAccelerators": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["cpu", "nvidia-cuda", "amd-rocm", "vulkan", "intel-openvino"] }
        },
        "supportedPlatforms": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["linux/amd64", "linux/arm64"] }
        },
        "configurableParameters": {
            "type": "object",
            "additionalProperties": true
        },
        "profiles": {
            "type": "object",
            "additionalProperties": true
        },
        "resourceEstimates": {
            "type": "object",
            "additionalProperties": true
        }
    }
}
